{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wortlaut",
  "version": "0.2.2",
  "identifier": "io.github.zdkderpphb.wortlaut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wortlaut",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "publisher": "Wortlaut",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "Audio und Video lokal in Text umwandeln",
    "longDescription": "Wortlaut wandelt Audio- und Videodateien mit dem Sprachmodell Voxtral komplett offline auf Ihrem Computer in Text um – mit Sprecher-Erkennung, Zusammenfassung und Export für Word, MAXQDA, ATLAS.ti und NVivo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
