{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wortlaut",
  "version": "0.1.0",
  "identifier": "io.github.zdkderpphb.wortlaut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wortlaut",
        "width": 980,
        "height": 740,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Wortlaut",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "Audio und Video lokal in Text umwandeln",
    "longDescription": "Wortlaut wandelt Audio- und Videodateien mit dem Sprachmodell Voxtral komplett offline auf Ihrem Computer in Text um und speichert das Ergebnis als Word, Text oder Markdown.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
